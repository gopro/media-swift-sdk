{"sections":[],"metadata":{"title":"ExportEquirectangular","roleHeading":"Article","modules":[{"name":"GoProMediaSDK"}],"role":"article"},"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"type":"text","text":"The "},{"type":"codeVoice","code":"exportEquirectangular"},{"type":"text","text":" function exports and transcodes a GoPro .360 video into a"},{"type":"text","text":" "},{"type":"text","text":"standard equirectangular spherical video file with optional stabilization."}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"inlineContent":[{"text":"This features is delivered as a free function with supporting classes and enums","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"to provide options for customization."}],"type":"paragraph"},{"text":"Typical Usage","level":2,"type":"heading","anchor":"Typical-Usage"},{"inlineContent":[{"text":"To use this feature, add the following import to your Swift code:","type":"text"}],"type":"paragraph"},{"code":["import GoProMediaSDK"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Use the function:","type":"text"}],"type":"paragraph"},{"code":["public static func exportEquirectangular(","    _ options: GoProExportOptions,","    cancellation: (() -> Bool)?,","    progress: ((Double) -> Void)?",")"],"syntax":"swift","type":"codeListing"},{"text":"Threading model","level":2,"type":"heading","anchor":"Threading-model"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"exportEquirectangular"},{"type":"text","text":" function runs "},{"type":"strong","inlineContent":[{"type":"text","text":"synchronously"}]},{"type":"text","text":" on the calling"},{"type":"text","text":" "},{"type":"text","text":"thread. Both the "},{"type":"codeVoice","code":"cancellation"},{"type":"text","text":" and "},{"type":"codeVoice","code":"progress"},{"type":"text","text":" callbacks are invoked from an"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"type":"text","text":"internal worker thread"}]},{"type":"text","text":" — update UI state inside a "},{"code":"Task { @MainActor in … }","type":"codeVoice"},{"type":"text","text":" "},{"text":"block or via ","type":"text"},{"type":"codeVoice","code":"DispatchQueue.main"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"heading","text":"Error Handling","level":2,"anchor":"Error-Handling"},{"type":"paragraph","inlineContent":[{"text":"This method ","type":"text"},{"inlineContent":[{"text":"does not throw","type":"text"}],"type":"strong"},{"text":" an exception. If the export fails, (e.g., unsupported","type":"text"},{"text":" ","type":"text"},{"text":"codec\/resolution > combination, corrupted source, or insufficient storage), it","type":"text"},{"text":" ","type":"text"},{"text":"returns silently. Verify the output > file exists and is non-empty after the call","type":"text"},{"text":" ","type":"text"},{"text":"returns.","type":"text"}]},{"text":"Example","type":"heading","level":2,"anchor":"Example"},{"syntax":"swift","type":"codeListing","code":["Task.detached {","    let options = GoProExportOptions(","        inputUrl:      inputURL,","        outputUrl:     outputURL,","        resolution:    GoProResolution(value: .value4K),","        codec:         .HEVC,","        stabilization: .allOn,","        bitrate:       0   \/\/ use SDK default","    )","","    exportEquirectangular(","        options,","        cancellation: { self.shouldCancel },","        progress: { fraction in","            Task { @MainActor in","                self.exportProgress = fraction","            }","        }","    )","}"]},{"level":2,"text":"Cancellation","anchor":"Cancellation","type":"heading"},{"inlineContent":[{"text":"It is possible to cancel the export during processing. Set a thread-safe flag","type":"text"},{"text":" ","type":"text"},{"text":"that your ","type":"text"},{"type":"codeVoice","code":"cancellation"},{"type":"text","text":" closure reads (it’s invoked from an SDK worker thread),"},{"type":"text","text":" "},{"type":"text","text":"then the SDK will stop at the next safe checkpoint:"}],"type":"paragraph"},{"syntax":"swift","code":[" final class CancelFlag {","     private let lock = NSLock(); private var _value = false","     var value: Bool { lock.lock(); defer { lock.unlock() }; return _value }","     func set(_ newValue: Bool) { lock.lock(); _value = newValue; lock.unlock() }"," }"," let cancelFlag = CancelFlag()","","\/\/ Start export","Task.detached {","    exportEquirectangular(","        options,","        cancellation: { cancelFlag.value },","        progress: nil","    )","}","","\/\/ Elsewhere, to abort:","cancelFlag.set(true)"],"type":"codeListing"},{"type":"heading","text":"Usage Tips","level":2,"anchor":"Usage-Tips"},{"type":"heading","text":"Resolution","level":3,"anchor":"Resolution"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For best compatibility, prefer preset values (e.g. "},{"code":".value4K","type":"codeVoice"},{"text":", ","type":"text"},{"code":".value56K","type":"codeVoice"},{"text":") when possible.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"When using custom dimensions:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If you do specify a custom height, keep it in the range "},{"type":"strong","inlineContent":[{"text":"500-2688 pixels","type":"text"}]},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use an aspect ratio of 2:1 (width:height) to maintain a canonical equirectangular aspect ratio."},{"type":"text","text":" "},{"type":"text","text":"Using a custom resolution with a different aspect ratio may result in unexpected behavior."}]}]}],"type":"unorderedList"}]}],"type":"unorderedList"},{"level":3,"text":"UI Resolution Selection","type":"heading","anchor":"UI-Re